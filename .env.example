# oidc + oauth2 secret

GOOGLE_CLIENT_ID = google_client-id
GOOGLE_CLIENT_SECRET = google_client_secret

GITHUB_CLIENT_ID = github_clinet_id
GITHUB_CLIENT_SECRET = github_client_secret

# Server
PORT=4001
NODE_ENV=development

# Database
POSTGRES_USER=db_user_name
POSTGRES_PASSWORD=db_password
POSTGRES_DB=dev_db

DATABASE_URL=DATABASE_URL="postgresql://postgres_user_name:postgres_password@localhost:5432/database_name"

# JWT
# Generate each secret with: openssl rand -base64 48
# Expiry values are in seconds.

# Access token (900 = 15 minutes can be customized)
JWT_ACCESS_SECRET_KEY=your_access_secret_key_here
JWT_ACCESS_SECRET_KEY_EXPIRES_IN=900

# Refresh token (604800 = 7 days, 2592000 = 30 days, 7776000 = 90 days)
JWT_REFRESH_SECRET_KEY=your_refresh_secret_key_here
JWT_REFRESH_SECRET_KEY_EXPIRES_IN=604800