# has to be set in google client

GOOGLE_CLIENT_ID = google_client-id
GOOGLE_CLIENT_SECRET = google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_START_PATH =/auth/google/start
APP_URL=http://localhost:3000

#Resend
RESEND_API_KEY=resend_api_key
# Change this to your verified Resend custom domain (e.g., yourname@yourdomain.com)
EMAIL_FROM=onboarding@yourdomain.com

# Server
PORT=4001
NODE_ENV=development

# Database
POSTGRES_USER=postgres_user_name
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=database_name

DATABASE_URL="postgresql://postgres_user_name:postgres_password@127.0.0.1:5432/database_name?schema=public"
# JWT
# Generate each secret with: openssl rand -base64 48
# Expiry values are in seconds.

# Access token (900 = 15 minutes can be customized)
JWT_ACCESS_SECRET_KEY=your_access_secret_key_here
JWT_ACCESS_SECRET_KEY_EXPIRES_IN=900

# Refresh token (604800 = 7 days, 2592000 = 30 days, 7776000 = 90 days)
JWT_REFRESH_SECRET_KEY=your_refresh_secret_key_here
JWT_REFRESH_SECRET_KEY_EXPIRES_IN=604800

COOKIE_SECRET = your_cookie_secret_here